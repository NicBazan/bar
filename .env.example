# Copiar a .env (raíz y packages/db/.env)
DATABASE_URL="postgresql://bar:bar_dev_password@localhost:5433/bar?schema=public"
REDIS_URL="redis://localhost:6380"

# Opcional: fotos y modelos 3D en Cloudinary (si falta, se guardan en el disco de la API)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Opcional: "Mi cuenta". Sin EMAIL_PROVIDER, los emails (códigos y promos) van al log de la API
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM="Bar <no-reply@tu-dominio.com>"
# Web Push: si faltan, las claves se derivan de JWT_SECRET (en producción, definirlas)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@tu-dominio.com
